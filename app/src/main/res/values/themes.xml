<resources>
    <style name="Theme.Salon" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#8D3C32</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#C99B4A</item>
        <item name="colorOnSecondary">#241B18</item>
        <item name="android:colorBackground">#F5F1E9</item>
        <item name="colorSurface">#FFFEFC</item>
        <item name="colorOnSurface">#241B18</item>
        <item name="android:statusBarColor">#F5F1E9</item>
        <item name="android:navigationBarColor">#FFFEFC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Btn</item>
        <item name="materialCardViewStyle">@style/Card</item>
        <item name="textInputStyle">@style/Field</item>
    </style>
    <style name="Btn" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">#FFFEFC</item>
    </style>
    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item><item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item><item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="Lbl"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textStyle">bold</item><item name="android:layout_marginTop">14dp</item><item name="android:layout_marginBottom">4dp</item></style>
</resources>
